# Copy to .env (git-ignored) and fill in. Used by scripts/seed-bubble.mjs and scripts/smoke-test.mjs.
BUBBLE_API_BASE=https://ajayraghav20047.bubbleapps.io/version-test/api/1.1
# Bubble editor → Settings → API → "Generate a new API token" (admin token, bypasses privacy rules)
BUBBLE_API_TOKEN=
# Password given to every seeded demo account (10 authors + admin). Share it with reviewers.
DEMO_PASSWORD=
ADMIN_EMAIL=admin@bookleaf.test
# Inbox that receives the demo royalty emails (dataset emails are fake)
DEMO_RECIPIENT=
# Used only for local prompt tests (scripts/preview-email.mjs); n8n has its own credential
ANTHROPIC_API_KEY=
